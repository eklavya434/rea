# ==============================================================================
# Website X-Ray Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL is standard; SQLite supported for zero-setup local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_xray?schema=public"

# AI Provider API Keys (Leave blank to use heuristic fallback analysis mode)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# REA MCP Server Integration (Optional: connect to a running REA MCP Server)
REA_MCP_ENABLED="false"
REA_MCP_URL="http://127.0.0.1:8000/sse"
REA_MCP_TOKEN=""

# Security and Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Development Access Mode: set to "true" to permit local dev user sandbox.
# When false in production, requires validated authentication.
APP_DEV_MODE="true"
