# ==============================================================================
# Website X-Ray Environment Configuration
# ==============================================================================

# Database Connection
# Standard Production: PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_xray?schema=public"
# Zero-Setup Local Development (SQLite):
# Run `npm run db:use-sqlite` to switch Prisma schema to SQLite:
# DATABASE_URL="file:./dev.db"

# Security & Authentication
# Required in production. Bearer token / API key checked on API routes:
AUTH_SECRET="replace-with-a-secure-random-secret-token"
APP_API_TOKEN="replace-with-a-secure-random-secret-token"

# Development Access Mode: set to "true" to permit local dev user sandbox.
# SECURITY: Ignored and strictly rejected when NODE_ENV === "production".
APP_DEV_MODE="true"

# SSRF Safeguards: Comma-separated list of permitted destination ports.
# Default strictly: 80,443 (disallowing internal service ports like 3000, 5432, etc.)
SSRF_ALLOWED_PORTS="80,443"

# AI Provider API Keys & Model Configuration
# Leave blank to use offline deterministic DOM Heuristic Extraction mode.
AI_PROVIDER="" # Optional: force "gemini" | "openai" | "anthropic"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# REA MCP Server Integration
# Set to "true" to enable genuine REA reverse-engineering MCP tool discovery and execution.
# If "false", the application operates in clean browser-evidence fallback mode.
REA_MCP_ENABLED="false"
# Transport: "stdio" (default, launches `rea --mcp`) or "http" (connects to REA_MCP_URL)
REA_MCP_TRANSPORT="stdio"
REA_MCP_URL="http://127.0.0.1:8000/sse"
REA_MCP_TOKEN=""

# Application Host & Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
